.skip-link {
  position: absolute; top: -40px; left: 0;
  background: #00d4ff; color: #000; padding: 8px 16px;
  z-index: 10000; text-decoration: none; border-radius: 0 0 8px 0;
  transition: top 0.3s;
}
.skip-link:focus { top: 0; }

*:focus-visible {
  outline: 2px solid #00d4ff;
  outline-offset: 2px;
}

/* Kurangi animasi jika user preferensi */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}
